{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "EasyGoal",
  "colors": {
    "primary": "#F97316",
    "light": "#FB923C",
    "dark": "#EA580C"
  },
  "background": {
    "dark": "#0F1729"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Introdução",
        "groups": [
          {
            "group": "Visão Geral",
            "pages": ["index", "introducao/arquitetura", "introducao/ecossistema", "introducao/easy-labs", "introducao/llm-context"]
          },
          {
            "group": "Monorepo",
            "pages": ["monorepo/estrutura", "monorepo/setup", "monorepo/contribuindo"]
          }
        ]
      },
      {
        "tab": "Plataforma",
        "groups": [
          {
            "group": "Perfis & Acesso",
            "pages": ["app-front/perfis"]
          },
          {
            "group": "Área do Usuário",
            "pages": ["app-front/usuario", "app-front/afiliado", "app-front/roadmap", "app-front/beta-program"]
          },
          {
            "group": "Área do Produtor",
            "pages": [
              "app-front/produtor",
              "app-front/produtor/squad",
              "app-front/produtor/cobranca",
              "app-front/produtor/relatorios"
            ]
          },
          {
            "group": "Área Admin",
            "pages": ["app-front/admin", "app-front/admin-beta"]
          }
        ]
      },
      {
        "tab": "Para Produtores",
        "groups": [
          {
            "group": "Steps do Produto SaaS",
            "pages": [
              "typebot/visao-geral",
              "typebot/step-1-dados-basicos",
              "typebot/step-2-sso",
              "typebot/step-3-pagamentos",
              "typebot/step-4-testes"
            ]
          }
        ]
      },
      {
        "tab": "SSO & Club LP",
        "groups": [
          {
            "group": "SSO",
            "pages": [
              "sso/visao-geral",
              "sso/fluxo-oauth",
              "sso/endpoints",
              "sso/autenticacao-cross-domain"
            ]
          },
          {
            "group": "Club LP",
            "pages": [
              "club-lp/visao-geral",
              "club-lp/implementacao"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Referência",
            "pages": [
              "api-reference/introducao",
              "api-reference/sso-api",
              "api-reference/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Suporte",
          "href": "mailto:contato@easygoal.com.br",
          "icon": "envelope"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/easygoal",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Suporte",
        "href": "mailto:contato@easygoal.com.br"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Acessar App",
      "href": "https://app.easygoal.com.br"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/easygoal"
    }
  }
}
